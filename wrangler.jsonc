{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "united-identity",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "kv_namespaces": [
    {
      "binding": "IDENTITY_KV",
      "id": "3f6e852d0beb4c1b836ac751c18eb222"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 4 * * *",
      "30 5 * * *",
      "0 7 * * *",
      "30 8 * * *",
      "0 10 * * *",
      "30 11 * * *",
      "0 13 * * *",
      "30 14 * * *",
      "0 16 * * *",
      "30 17 * * *"
    ]
  }
}
